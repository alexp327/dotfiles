# Theme — try these, pick your favorite
# theme = Catppuccin Mocha
# theme = Dracula
# theme = Tokyo Night
theme = deep

# Font — tweak to your Nerd Font
font-family = JetBrainsMono Nerd Font
font-size = 13

# Truecolor (usually auto-detected, but explicit is safer)
term = xterm-256color
window-colorspace = display-p3

# Quality of life
window-padding-x = 12
window-padding-y = 8
# cursor-style = bar
cursor-style = block
mouse-hide-while-typing = true

# remove ligatures
font-feature = -calt
